{
  "model": "sonnet",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80"
  },
  "permissions": {
    "allow": [
      "Bash(powershell -Command \"\\(Get-CimInstance Win32_Service -Filter \"\"Name=''postgresql-x64-17''\"\"\\).PathName\")",
      "Bash(gh api:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:apis.datos.gob.ar)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(python:*)",
      "Bash(pip install:*)",
      "Bash(psql:*)",
      "Bash(git add:*)",
      "Bash(export:*)"
    ]
  }
}
